# Come as you are by Nirvana

bpm 120
tsu 4
tsl 4

[riffp1]
vol 200
wave tri
mes 1

fx;
over 1 # Clean sound
decay 4
ring 1
ext;

ton p p 5 5 6
len 2 8 8 8 8

end

[loop1]
vol 200
wave tri # Options: Sin, Squ, Saw, Tri
mes 2

fx;
over 1 # Clean sound
decay 4
ring 1
ext;

ton 7 10 7 10 7 7 6 5 12 5 5 12 5 6
len 4 8 8 8 8 8 8 8 8 8 4 8 8 8

end
[def]
riffp1 1
loop1 11

end
